{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "ES2023",

    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",

    "types": [
      "vite/client"
    ],

    "skipLibCheck": true,

    /* Bundler */

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,          // ✅ ADDED — required by Vite's esbuild
    "moduleDetection": "force",
    "noEmit": true,

    /* React */

    "jsx": "react-jsx",

    /* Strict */

    "strict": true,

    /* Alias */

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"],
      "@api/*": ["src/api/*"],
      "@components/*": ["src/components/*"],
      "@features/*": ["src/features/*"],
      "@hooks/*": ["src/hooks/*"],
      "@store/*": ["src/store/*"],
      "@lib/*": ["src/lib/*"],
      "@types/*": ["src/types/*"]
    },

    /* Lint */

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },

  "include": ["src"]
}